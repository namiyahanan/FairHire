# FairHire Environment Variables
# Copy this file to .env and fill in your own values

# API Configuration
VITE_API_BASE_URL=https://your-api-host.example.com/webhook/candidate-workflow-system
VITE_API_MODE=mock

# Auth Mode: "mock" for local dev, "live" for Supabase
VITE_AUTH_MODE=mock

# Supabase Configuration (get from https://supabase.com/dashboard)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Webhook URLs (replace with your actual endpoints)
VITE_HR_WORKFLOW_WEBHOOK_URL=https://your-api-host.example.com/webhook/hr-workflow-system
VITE_CANDIDATE_WORKFLOW_WEBHOOK_URL=https://your-api-host.example.com/webhook/candidate-workflow-system
VITE_RESUME_PARSING_WEBHOOK_URL=https://your-api-host.example.com/webhook/your-resume-parsing-id
